# Copy to backend/.env and fill in real values. Never commit .env.

# Postgres connection strings
DEV_DB=postgres://USER:PASSWORD@localhost:3333/dev_db
TEST_DB=postgres://USER:PASSWORD@localhost:4444/test_db

# HS256 secret for JWT signing. Use at least 64 random bytes in production
# (e.g. `openssl rand -base64 64`). Rotate periodically.
ENCRYPTION_KEY=replace-me-with-a-long-random-secret

# Comma-separated list of allowed CORS origins. Use "*" only for local dev.
ALLOWED_ORIGINS=http://localhost:8000

# Database connection pool size (default 16)
DB_POOL_SIZE=16

# Bind address (default 0.0.0.0:3000)
BIND_ADDRESS=0.0.0.0:3000
